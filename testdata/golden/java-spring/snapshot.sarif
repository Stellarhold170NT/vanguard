            {
              "id": "R5xx-01",
              "name": "unified-error-shape",
              "shortDescription": {
                "text": "Every @ExceptionHandler must answer with the app's one error envelope — a handler returning a different structure splits the error contract clients parse."
              },
              "fullDescription": {
                "text": "Every @ExceptionHandler must answer with the app's one error envelope — a handler returning a different structure splits the error contract clients parse."
