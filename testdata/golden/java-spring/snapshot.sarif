              "name": "status-semantics",
              "shortDescription": {
                "text": "A POST that creates a resource must answer 201 (Created) or 202 (Accepted) — 200 (declared or the implicit convention) hides the creation from clients."
              },
              "fullDescription": {
                "text": "A POST that creates a resource must answer 201 (Created) or 202 (Accepted) — 200 (declared or the implicit convention) hides the creation from clients."
