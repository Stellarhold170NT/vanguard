            {
              "id": "R1xx-02",
              "name": "no-verb-path",
              "shortDescription": {
                "text": "No CRUD verb in the path — the HTTP verb already carries the action (AIP-131, AIP-133, AIP-135)."
              },
              "fullDescription": {
                "text": "No CRUD verb in the path — the HTTP verb already carries the action (AIP-131, AIP-133, AIP-135)."
