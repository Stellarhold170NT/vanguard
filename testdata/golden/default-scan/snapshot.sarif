{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "vanguard",
          "version": "0.1.0-dev",
          "informationUri": "https://github.com/Stellarhold170NT/vanguard",
          "rules": [
            {
              "id": "R2xx-01",
              "name": "get-no-body",
              "shortDescription": {
                "text": "GET endpoints must not declare a request body — many HTTP clients silently drop GET bodies."
              },
              "fullDescription": {
                "text": "GET endpoints must not declare a request body — many HTTP clients silently drop GET bodies."
              },
              "helpUri": "docs/rules/R2xx-01-get-no-body.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "methods"
              }
            },
            {
              "id": "R6xx-91",
              "name": "demo-bad-method-name",
              "shortDescription": {
                "text": "Method names must not carry the demoBad fixture marker — one canonical operation name per endpoint."
              },
              "fullDescription": {
                "text": "Method names must not carry the demoBad fixture marker — one canonical operation name per endpoint."
              },
              "helpUri": "docs/rules/R6xx-91-demo-bad-method-name.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "demo"
              }
            },
            {
              "id": "R6xx-92",
              "name": "demo-no-response-type",
              "shortDescription": {
                "text": "Every operation must declare a response type — clients cannot deserialize an undeclared result."
              },
              "fullDescription": {
                "text": "Every operation must declare a response type — clients cannot deserialize an undeclared result."
              },
              "helpUri": "docs/rules/R6xx-92-demo-no-response-type.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "demo"
              }
            },
            {
              "id": "R6xx-93",
              "name": "demo-get-with-body",
              "shortDescription": {
                "text": "GET endpoints should not declare a request body — many HTTP clients silently drop GET bodies."
              },
              "fullDescription": {
                "text": "GET endpoints should not declare a request body — many HTTP clients silently drop GET bodies."
              },
              "helpUri": "docs/rules/R6xx-93-demo-get-with-body.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "demo"
              }
            }
          ]
        }
      },
