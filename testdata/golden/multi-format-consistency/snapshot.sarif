        {
          "ruleId": "R6xx-93",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "GET endpoint demoBadSearchInventory declares a request body — many HTTP clients silently drop GET bodies."
          },
          "locations": [
