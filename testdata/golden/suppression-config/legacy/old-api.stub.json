{
  "service": "LegacyLedger",
  "basePath": "/v1/ledger",
  "methods": [
    {"name": "demoBadListLedger", "verb": "GET", "path": "/entries",
     "response": {"type": "LedgerEntryList", "statusCode": 200, "isCollection": true}},
    {"name": "exportLedger", "verb": "POST", "path": "/export"}
  ],
